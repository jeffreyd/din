; din sample configuration
; Copy to ~/.din/config and fill in your server details.
;
; Multiple [server "name"] sections are supported.
; din uses the first server by default; pass -s <name> to select another.

[server "mynews"]
host        = news.example.com
port        = 563
tls         = true
user        = myusername
pass        = mypassword
connections = 8

; [server "backup"]
; host        = news2.example.com
; port        = 563
; tls         = true
; user        = myusername
; pass        = mypassword
; connections = 4

[options]
download_dir        = ~/Downloads/usenet
auto_par2           = true
delete_par2         = true
cache_dir           = ~/.din/cache
max_header_age_days = 30
editor              = $VISUAL
